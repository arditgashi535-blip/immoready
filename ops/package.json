{
  "name": "readyops",
  "private": true,
  "description": "ReadyOps – mandantenfähiges CRM, Freigabe-Warteschlange und Lead-Piloten für ImmoReady und Ready Studio (ohne externe Abhängigkeiten)",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "test": "node --no-warnings --test test/*.test.js",
    "test:ui": "node --no-warnings test-ui/approval-ui.js",
    "test:all": "npm test && npm run test:ui",
    "seed:users": "node --no-warnings scripts/create-user.js",
    "import:leads": "node --no-warnings scripts/import-leads.js",
    "research:immo": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/research-immoready.js",
    "research:studio": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/research-readystudio.js",
    "handoff": "node --no-warnings scripts/handoff.js",
    "digest": "node --no-warnings scripts/digest.js"
  }
}
